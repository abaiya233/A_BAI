# ---------------------------------------------------------------------------
# 大肥鱼工具箱
# ---------------------------------------------------------------------------

# 下载的第三方组件：体积几百 MB，而且含你自己的登录凭据
components/

# 运行数据：日志、下载缓存、AstrBot 的 root 数据
data/
logs/

# 打包产物
dist/

# ★ 私人配置：MCS 面板账号密码明文存在这里，绝对不能提交
server/config.json

# ---------------------------------------------------------------------------
# 通用
# ---------------------------------------------------------------------------

node_modules/
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp

# 备份与临时文件
*.bak
*.tbx-bak
*.part
*.log
~$*
*.旧版备份

# ---------------------------------------------------------------------------
# 编译产物：由 shell/build.bat 生成，clone 后自己编译即可，不必进仓库
# ---------------------------------------------------------------------------
shell/*.exe
shell/Microsoft.Web.WebView2.*.dll
shell/WebView2Loader.dll

# ---------------------------------------------------------------------------
# WebView2 SDK 二进制（微软的，约 830 KB）
# 不随仓库分发：clone 后从 NuGet 下载 Microsoft.Web.WebView2 包，
# 把三个 DLL 解压到 panel/ 即可编译。详见 README「编译原生壳」。
# 这个目录里只放这三个 DLL，其余东西都在源码里。
# ---------------------------------------------------------------------------
panel/*.dll
